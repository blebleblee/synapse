[Unit]
Description=AI Learning Workbench Service
After=network.target

[Service]
Type=simple
User=synapse
WorkingDirectory=/opt/synapse
ExecStart=/usr/bin/python3 -m uvicorn app.backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
Environment=PATH=/opt/synapse/.venv/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
